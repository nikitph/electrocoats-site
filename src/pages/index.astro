---
/**
 * Homepage. Follows the original site's order (slider → about → what we do →
 * products → clients → feedback → statistics) with clients and feedback moved
 * up so they sit right under the hero.
 */
import Base from '../layouts/Base.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import Enquiry from '../components/Enquiry.astro';
import { products } from '../data/products';
import { certs, clientGroups, testimonials, capabilities, homeProducts, stats, company } from '../data/site';

const logos = clientGroups.flatMap((g) => g.clients).filter((c) => c.logo);
const clientCount = clientGroups.reduce((n, g) => n + g.clients.length, 0);
const capIcons = [
  'M4 20V9l8-5 8 5v11M9 20v-6h6v6',
  'M5 7h14v12H5zM9 7V4h6v3M8 12h8M8 15h5',
  'M12 3v6M8 9h8l-1 11H9zM10 13h4',
  'M4 16c3-6 13-6 16 0M7 13a5 5 0 0 1 10 0M12 16v4',
];
---
<Base title="Electrocoats: epoxy & PU potting, casting and insulation resins, Pune" description="Electrocoating & Insulation Technologies manufactures UL 94 V-0 listed epoxy, polyurethane and silicone potting compounds, casting resins, insulating varnishes, wire enamels and battery sealing epoxies in Pune, India. ISO 9001:2015, RoHS, 20 t/day.">

  <HeroCarousel />

  <!-- ───────── CLIENT STRIP (above the fold) ───────── -->
  <section class="cstrip" aria-label="Clients">
    <div class="cstrip__lbl wrap mono"><span><b class="accent">{clientCount}</b> manufacturers trust our resins</span><a href="/clients/">All clients →</a></div>
    <div class="marquee">
      <div class="marquee__track">
        {[...logos, ...logos].map((c, i) => (
          <img class="logo-ink" src={`/img/clients/${c.logo}.png`} alt={i < logos.length ? c.n : ''} width="150" height="80" loading={i < 10 ? 'eager' : 'lazy'} />
        ))}
      </div>
    </div>
  </section>

  <!-- ───────── TESTIMONIALS ───────── -->
  <section class="tm" data-carousel data-interval="8000" aria-label="Client feedback">
    <div class="wrap tm__in">
      <div class="tm__head">
        <p class="eyebrow">Client’s feedback</p>
        <span class="tm__q" aria-hidden="true">“</span>
      </div>
      <div class="tm__body" data-stage>
        <div class="tm__slides">
          {testimonials.map((t, i) => (
            <figure class:list={['tm__s', { on: i === 0 }]} data-slide-text={i}>
              <blockquote>{t.q}</blockquote>
              <figcaption><b>{t.n}</b><span class="mono">{t.c}</span></figcaption>
            </figure>
          ))}
        </div>
        <div class="tm__tabs" role="tablist" aria-label="Choose a testimonial">
          {testimonials.map((t, i) => (
            <button type="button" role="tab" class:list={['tm__tab', { on: i === 0 }]} data-tab={i} aria-selected={i === 0 ? 'true' : 'false'}>
              <span class="tm__tab-t">{t.c.replace(/ (Pvt\.|Co\.|India).*$/, '')}</span>
              <span class="tm__bar"><i data-bar></i></span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── ABOUT ───────── -->
  <section class="section about">
    <div class="wrap split">
      <div class="about__fig" data-reveal>
        <img src="/img/site/about.jpg" alt="Electrocoats plant exterior and epoxy-coated factory floor" width="569" height="605" loading="lazy" />
        <span class="about__tag mono">EST. 2002 · PUNE</span>
      </div>
      <div>
        <p class="eyebrow" data-reveal>Know us</p>
        <h2 class="h-l" data-split>About company</h2>
        <div class="about__txt" data-reveal>
          <p class="big">EITPL is an ISO 9001:2015 certified manufacturer of epoxy resins, hardeners, polyurethane and resin formulations, with more than 30 years of experience.</p>
          <p>Our potting compounds are UL approved under file {company.ul} and RoHS compliant. Two production facilities of 3,000 m² and 6,500 m² around Pune give us a capacity of 20 tonnes a day, so we can meet your requirements quickly.</p>
        </div>
        <div class="about__certs" data-stagger>
          {certs.map((c) => <a href="/quality/" class="cert"><span class="mono accent">{c.k}</span><b>{c.v}</b></a>)}
        </div>
        <a href="/company/" class="btn" data-reveal>Read more <span class="arr">→</span></a>
      </div>
    </div>
  </section>

  <!-- ───────── WHAT WE DO ───────── -->
  <section class="section wwd">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow" data-reveal>We specialise in</p>
        <h2 class="h-l" data-split>What we do</h2>
        <p class="lede" data-reveal>Epoxy, polyurethane, phenolic and silicone resins are thermoset polymers. We formulate them for:</p>
      </div>
      <div class="wwd__grid">
        <ol class="wwd__list" data-stagger>
          {capabilities.map((c, i) => (
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={capIcons[i]} /></svg>
              <span class="mono">0{i + 1}</span>
              <h3>{c}</h3>
            </li>
          ))}
        </ol>
        <div class="video ticks" data-video="eOmpd1Tgobo" data-reveal>
          <img src="/img/slider/2.jpg" alt="" loading="lazy" />
          <button type="button" class="video__play" aria-label="Play company video">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
          </button>
          <span class="video__lbl mono">Watch · company film</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── OUR PRODUCTS ───────── -->
  <section class="section ourp">
    <div class="wrap">
      <div class="sec-head row-head">
        <div>
          <p class="eyebrow" data-reveal>We deal with</p>
          <h2 class="h-l" data-split>Our products</h2>
        </div>
        <a href="/products/" class="btn" data-reveal>All {products.length} products <span class="arr">→</span></a>
      </div>
      <div class="ourp__grid" data-stagger>
        {homeProducts.map((p, i) => (
          <a href={p.href} class="pt" data-tilt>
            <div class="pt__img"><img src={p.img} alt={p.t} width="740" height="526" loading="lazy" /></div>
            <div class="pt__cap">
              <span class="mono">0{i + 1}</span>
              <h3>{p.t}</h3>
              <span class="pt__go" aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ───────── STATISTICS ───────── -->
  <section class="stats">
    <div class="wrap">
      <p class="eyebrow">We are at</p>
      <div class="stats__grid" data-stagger>
        {stats.map((s) => (
          <div class="stat">
            <div class="stat__v">{s.pre && <span class="accent">{s.pre}</span>}<span data-count={s.v}>{s.v}</span><span class="accent">{s.suf}</span></div>
            <p>{s.l}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Enquiry />
</Base>

<style>
  .sec-head { margin-bottom: clamp(36px, 5vw, 64px); display: grid; gap: 16px; max-width: 900px; }
  .row-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; max-width: none; }

  /* client strip */
  .cstrip { padding: 16px 0 20px; border-top: 1px solid var(--line-2); border-bottom: 1px solid var(--line-2); background: var(--bg-2); }
  .cstrip__lbl { display: flex; justify-content: space-between; gap: 12px; color: var(--ink-3); margin-bottom: 12px; font-size: .72rem; text-transform: uppercase; letter-spacing: .1em; }
  .cstrip__lbl a:hover { color: var(--accent); }
  @media (max-width: 520px) { .cstrip__lbl a { display: none; } }
  .cstrip .marquee__track { gap: 14px; animation-duration: 70s; }
  .cstrip img { height: 60px; width: auto; }

  /* testimonials: navy band */
  .tm { background: var(--navy); color: #eef0f8; padding: clamp(64px, 9vw, 120px) 0; position: relative; overflow: hidden; --heading: #fff; }
  .tm::before { content: ''; position: absolute; inset: 0; background-image: repeating-linear-gradient(30deg, rgba(255,255,255,.05) 0 1px, transparent 1px 44px), repeating-linear-gradient(150deg, rgba(255,255,255,.05) 0 1px, transparent 1px 44px); pointer-events: none; }
  .tm .eyebrow { color: #ff7a83; }
  .tm__in { display: grid; gap: 24px; position: relative; }
  @media (min-width: 1000px) { .tm__in { grid-template-columns: 240px 1fr; gap: 56px; } }
  .tm__q { display: block; font-family: Georgia, serif; font-size: clamp(6rem, 12vw, 11rem); line-height: .7; color: var(--red); margin-top: 24px; }
  .tm__slides { display: grid; }
  .tm__s { grid-area: 1 / 1; margin: 0; visibility: hidden; display: grid; align-content: start; gap: 28px; }
  .tm__s.on { visibility: visible; }
  .tm__s blockquote { margin: 0; font-size: clamp(1.35rem, 2.6vw, 2.3rem); line-height: 1.24; font-weight: 600; font-stretch: 104%; color: #fff; max-width: 36ch; }
  .tm__s figcaption { display: grid; gap: 4px; }
  .tm__s figcaption b { font-size: 1.1rem; font-stretch: 110%; }
  .tm__s figcaption .mono { color: #aab0d0; }
  .tm__tabs { display: flex; flex-wrap: wrap; margin-top: 36px; border-top: 1px solid rgba(255,255,255,.18); }
  .tm__tab { position: relative; flex: 1 1 150px; text-align: left; padding: 14px 14px 4px 0; background: none; border: 0; color: #8d93b8; cursor: pointer; font-family: var(--mono); font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; transition: color .3s; }
  .tm__tab:hover, .tm__tab.on { color: #fff; }
  .tm__bar { position: absolute; left: 0; right: 12px; top: -1px; height: 2px; overflow: hidden; }
  .tm__bar i { display: block; height: 100%; background: var(--red); transform: scaleX(0); transform-origin: left; }
  .tm__tab.done .tm__bar i { transform: scaleX(1); background: rgba(255,255,255,.35); }

  /* about */
  .about__fig { position: relative; overflow: hidden; clip-path: polygon(0 0, calc(100% - 24px) 0, 100% 24px, 100% 100%, 24px 100%, 0 calc(100% - 24px)); }
  .about__fig img { width: 100%; height: auto; transition: transform 1.2s var(--ease); }
  .about__fig:hover img { transform: scale(1.04); }
  .about__tag { position: absolute; left: 16px; top: 16px; background: var(--navy); color: #fff; padding: 6px 10px; font-size: .68rem; }
  .about__txt { margin: 22px 0 26px; }
  .about__txt p { color: var(--ink-2); margin: 0 0 1em; max-width: 60ch; }
  .about__txt .big { color: var(--ink); font-size: clamp(1.1rem, 1.6vw, 1.35rem); line-height: 1.45; }
  .about__certs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-bottom: 28px; }
  @media (min-width: 640px) { .about__certs { grid-template-columns: repeat(4, 1fr); } }
  .cert { display: grid; gap: 2px; padding: 12px 14px; border: 1px solid var(--line-2); background: var(--panel); transition: border-color .3s, transform .4s var(--ease); }
  .cert:hover { border-color: var(--accent); transform: translateY(-2px); }
  .cert b { font-stretch: 110%; }

  /* what we do */
  .wwd { border-top: 1px solid var(--line-2); }
  .wwd__grid { display: grid; gap: 32px; grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 1000px) { .wwd__grid { grid-template-columns: 1fr 1.1fr; gap: 56px; } }
  .wwd__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .wwd__list li { border: 1px solid var(--line-2); background: var(--panel); padding: 20px; display: grid; gap: 10px; align-content: start; transition: border-color .3s, transform .4s var(--ease); }
  .wwd__list li:hover { border-color: var(--accent); transform: translateY(-3px); }
  .wwd__list svg { width: 34px; height: 34px; fill: none; stroke: var(--navy); stroke-width: 1.2; stroke-linejoin: round; }
  :root[data-theme="dark"] .wwd__list svg { stroke: var(--ink); }
  .wwd__list .mono { color: var(--accent); font-size: .66rem; }
  .wwd__list h3 { font-size: 1.15rem; font-stretch: 108%; line-height: 1.2; }
  .video { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #000; cursor: pointer; }
  .video img { width: 100%; height: 100%; object-fit: cover; opacity: .75; transition: transform 1s var(--ease), opacity .4s; }
  .video:hover img { transform: scale(1.04); opacity: .6; }
  .video__play { position: absolute; inset: 0; margin: auto; width: 84px; height: 84px; border-radius: 50%; border: 1px solid rgba(255,255,255,.7); background: rgba(237,53,65,.9); color: #fff; display: grid; place-items: center; cursor: pointer; transition: transform .4s var(--ease); }
  .video__play::after { content: ''; position: absolute; inset: -10px; border-radius: 50%; border: 1px solid rgba(255,255,255,.4); animation: ring 2s infinite; }
  @keyframes ring { from { transform: scale(.9); opacity: 1; } to { transform: scale(1.35); opacity: 0; } }
  .video:hover .video__play { transform: scale(1.08); }
  .video__play svg { width: 30px; height: 30px; fill: currentColor; margin-left: 4px; }
  .video__lbl { position: absolute; left: 16px; bottom: 14px; color: #fff; font-size: .7rem; }
  .video :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; z-index: 3; }

  /* our products */
  .ourp { border-top: 1px solid var(--line-2); }
  .ourp__grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }
  .pt { position: relative; display: block; border: 1px solid var(--line-2); background: var(--panel); transform-style: preserve-3d; transition: border-color .4s; }
  .pt:hover { border-color: var(--accent); }
  .pt__img { aspect-ratio: 740 / 526; overflow: hidden; position: relative; }
  .pt__img::after { content: ''; position: absolute; inset: 0; background-image: repeating-linear-gradient(30deg, rgba(255,255,255,.22) 0 1px, transparent 1px 26px), repeating-linear-gradient(150deg, rgba(255,255,255,.22) 0 1px, transparent 1px 26px); opacity: 0; transition: opacity .5s; }
  .pt:hover .pt__img::after { opacity: 1; }
  .pt__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  .pt:hover .pt__img img { transform: scale(1.07); }
  .pt__cap { display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: baseline; padding: 16px 18px; }
  .pt__cap .mono { color: var(--accent); font-size: .66rem; }
  .pt__cap h3 { font-size: 1.15rem; font-stretch: 108%; }
  .pt__go { color: var(--accent); transition: transform .4s var(--ease); }
  .pt:hover .pt__go { transform: translateX(4px); }

  /* stats */
  .stats { padding: 64px 0; border-top: 1px solid var(--line-2); background: var(--bg-2); }
  .stats__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px 20px; margin-top: 24px; }
  @media (min-width: 900px) { .stats__grid { grid-template-columns: repeat(5, 1fr); } }
  .stat__v { font-size: clamp(2.4rem, 5vw, 4rem); font-weight: 900; font-stretch: 122%; line-height: 1; letter-spacing: -.03em; color: var(--heading); }
  .stat p { color: var(--ink-3); margin: 8px 0 0; font-size: .9rem; }
</style>

<script>
  // click-to-load video: no YouTube requests until the visitor asks
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-video]').forEach((v) => {
      v.onclick = () => {
        if (v.querySelector('iframe')) return;
        const f = document.createElement('iframe');
        f.src = `https://www.youtube-nocookie.com/embed/${v.dataset.video}?autoplay=1&rel=0`;
        f.allow = 'autoplay; encrypted-media; picture-in-picture';
        f.allowFullscreen = true;
        f.title = 'Electrocoats company video';
        v.append(f);
      };
    });
  });
</script>
