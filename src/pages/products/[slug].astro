---
/**
 * /products/<slug>/ serves two kinds of page:
 *  - application categories (e.g. /products/batteries/), filtered finder
 *  - individual products (e.g. /products/epofil-60/)
 * Category slugs and product slugs never overlap.
 */
import ProductView from '../../components/ProductView.astro';
import CategoryView from '../../components/CategoryView.astro';
import { products, APPLICATIONS, type App, type Product } from '../../data/products';

export function getStaticPaths() {
  const cats = (Object.keys(APPLICATIONS) as App[]).map((app) => ({ params: { slug: APPLICATIONS[app].slug }, props: { app } }));
  const items = products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
  const clash = cats.find((c) => products.some((p) => p.slug === c.params.slug));
  if (clash) throw new Error(`Category slug collides with a product: ${clash.params.slug}`);
  return [...cats, ...items];
}
const { app, p } = Astro.props as { app?: App; p?: Product };
---
{app ? <CategoryView app={app} /> : <ProductView p={p!} />}
