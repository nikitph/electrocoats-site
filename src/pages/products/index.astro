---
import Base from '../../layouts/Base.astro';
import ProductFinder from '../../components/ProductFinder.astro';
import IsoApp from '../../components/iso/IsoApp.astro';
import { products, APPLICATIONS, appHref, type App } from '../../data/products';
const apps = Object.keys(APPLICATIONS) as App[];
---
<Base title="Products: potting, casting, coating & sealing resins" description="Every Electrocoats epoxy, polyurethane, silicone and phenolic product by application: electrical & electronics, batteries, civil engineering, modelling & tooling and general purpose.">
  <section class="phead">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span aria-current="page">Products</span></nav>
      <p class="eyebrow">Products</p>
      <h1 class="h-xl" data-split>{products.length} grades.<br /><span class="outline">Two clicks to a spec.</span></h1>
      <p class="lede">Start from your application, or filter the full range below by process, chemistry and the approvals it must carry.</p>
    </div>
  </section>

  <section class="cats">
    <div class="wrap">
      <p class="eyebrow">By application</p>
      <div class="cats__grid" data-stagger>
        {apps.map((k) => (
          <a href={appHref(k)} class="cat">
            <div class="cat__fig"><IsoApp kind={k} /></div>
            <h2>{APPLICATIONS[k].label}</h2>
            <span class="mono">{products.filter((p) => p.apps.includes(k)).length} grades →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="wrap all"><p class="eyebrow">All products</p></div>
  <ProductFinder />
</Base>
<style>
  .cats { padding: 48px 0 8px; }
  .cats__grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); margin-top: 18px; }
  .cat { display: grid; gap: 8px; padding: 18px; border: 1px solid var(--line-2); background: var(--panel); transition: border-color .3s, transform .4s var(--ease); }
  .cat:hover { border-color: var(--accent); transform: translateY(-3px); }
  .cat__fig { height: 110px; display: grid; place-items: center; }
  .cat__fig :global(svg) { max-height: 104px; width: auto; }
  .cat h2 { font-size: 1.1rem; font-stretch: 110%; }
  .cat .mono { color: var(--accent); font-size: .72rem; }
  .all { padding-top: 48px; }
</style>
