---
import Base from '../layouts/Base.astro';
import Legal from '../components/Legal.astro';
import policy from '../data/csr-policy.json';
import projects from '../data/csr-projects.json';
---
<Base title="Corporate social responsibility policy" description="CSR policy and CSR project areas of Electrocoating & Insulation Technologies Pvt. Ltd., under section 135 and Schedule VII of the Companies Act, 2013.">
  <section class="phead">
    <div class="wrap">
      <div class="crumbs"><a href="/">Home</a><span>/</span><span>CSR policy</span></div>
      <p class="eyebrow">Governance</p>
      <h1 class="h-l" data-split>Corporate social responsibility</h1>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <Legal blocks={policy as any} />
      <h2 class="h-m proj">CSR projects</h2>
      <Legal blocks={projects as any} />
    </div>
  </section>
</Base>
<style>.proj { margin-top: 80px; }</style>
