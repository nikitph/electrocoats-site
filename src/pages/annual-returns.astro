---
import Base from '../layouts/Base.astro';
const returns = [
  { fy: '2025–26', period: '01/04/2025 to 31/03/2026', form: 'MGT-7A (Abridged Annual Return)', href: '/docs/Annual-Return-MGT-7A-FY-2025-26.pdf' },
];
---
<Base title="Annual returns" description="Annual returns of Electrocoating & Insulation Technologies Pvt. Ltd. under section 92(3) of the Companies Act, 2013.">
  <section class="phead">
    <div class="wrap">
      <div class="crumbs"><a href="/">Home</a><span>/</span><span>Annual returns</span></div>
      <p class="eyebrow">Governance</p>
      <h1 class="h-l" data-split>Annual returns</h1>
      <p class="lede">In accordance with section 92(3) of the Companies Act, 2013, read with rule 12 of the Companies (Management and Administration) Rules, 2014, the company's annual return is placed below.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <table class="spec">
        <thead><tr><th>Financial year</th><th>Form</th><th>Document</th></tr></thead>
        <tbody>{returns.map((r) => <tr><td>{r.fy}<br /><small class="mono">{r.period}</small></td><td>{r.form}</td><td><a class="btn" href={r.href} target="_blank" rel="noopener">PDF ↓</a></td></tr>)}</tbody>
      </table>
    </div>
  </section>
</Base>
<style>small { color: var(--ink-3); } td { vertical-align: middle !important; }</style>
