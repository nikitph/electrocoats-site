---
import { company, nav } from '../data/site';
import { APPLICATIONS } from '../data/products';
const year = new Date().getFullYear();
---
<footer class="ft">
  <div class="wrap">
    <div class="ft__big" aria-hidden="true" data-marquee-text>
      <span class="outline">LIQUID</span> <span class="amber">→</span> <span>SHIELD</span>
    </div>
    <div class="ft__grid">
      <div>
        <a href="/" class="ft__brand"><span class="ft__plate"><img src="/img/logo.svg" alt={company.name} width="359" height="101" loading="lazy" /></span></a>
        <p class="mono ft__meta">ISO 9001:2015 · UL file {company.ul} · RoHS</p>
      </div>
      <div>
        <p class="eyebrow">Products</p>
        <ul>{Object.entries(APPLICATIONS).map(([k, v]) => <li><a href={`/products/?app=${k}`}>{v.label}</a></li>)}</ul>
      </div>
      <div>
        <p class="eyebrow">Company</p>
        <ul>
          {nav.filter((n) => n.label !== 'Products').map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/csr-policy/">CSR policy</a></li>
          <li><a href="/annual-returns/">Annual returns</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Reach us</p>
        <address>
          {company.works.lines.map((l) => <span>{l}</span>)}
        </address>
        <ul class="mono">
          {company.phones.map((p) => <li><a href={`tel:${p.tel}`}>{p.label}</a></li>)}
          <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
          <li><a href={company.works.map} target="_blank" rel="noopener">Open in Maps ↗</a></li>
        </ul>
      </div>
    </div>
    <hr class="rule" />
    <div class="ft__base mono">
      <span>© {year} {company.name}</span>
      <span>Pune · India</span>
    </div>
  </div>
</footer>

<style>
  .ft { border-top: 1px solid var(--line-2); padding: 80px 0 32px; position: relative; overflow: hidden; background: linear-gradient(transparent, rgba(244,166,42,.03)); }
  .ft__big { font-weight: 900; font-stretch: 125%; font-size: clamp(3rem, 13vw, 12rem); line-height: .9; letter-spacing: -.04em; white-space: nowrap; margin-bottom: 64px; }
  .ft__grid { display: grid; gap: 40px; grid-template-columns: 1fr; margin-bottom: 56px; }
  @media (min-width: 760px) { .ft__grid { grid-template-columns: 1.4fr 1fr 1fr 1.3fr; } }
  .ft__brand { display: inline-block; }
  .ft__plate { display: block; background: var(--plate); padding: 6px 10px; }
  .ft__plate img { height: 64px; width: auto; }
  .ft__meta { color: var(--ink-3); margin-top: 18px; }
  .ft ul { list-style: none; padding: 0; margin: 14px 0 0; display: grid; gap: 8px; }
  .ft ul a { color: var(--ink-2); transition: color .2s; }
  .ft ul a:hover { color: var(--amber); }
  .ft address { font-style: normal; display: grid; color: var(--ink-2); margin: 14px 0; }
  .ft__base { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding-top: 24px; color: var(--ink-3); }
</style>
