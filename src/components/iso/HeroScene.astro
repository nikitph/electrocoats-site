---
/**
 * Hero: an open potting housing with a populated PCB. The motion script pours
 * amber resin into it on scroll (#resin is rebuilt each frame from data-* dims),
 * submerges components, then "cures" it and reveals the proof callouts.
 */
import { P, box, cyl, toroid, trayBack, trayFront, line, ring, viewBox } from '../../lib/iso';

const W = 260, D = 170, H = 74, LEVEL = 62;

const parts: { top: number; svg: string }[] = [];
// standoffs + board
let board = '';
for (const [x, y] of [[22, 20], [238, 20], [22, 150], [238, 150]]) board += cyl(x, y, 0, 4, 6);
board += box(12, 10, 6, 236, 150, 4, { top: 'f-t pcb' });
// traces on board
let traces = '';
const tz = 10.2;
const tr: [number, number][][] = [
  [[40, 30], [100, 30], [110, 40], [150, 40]],
  [[40, 140], [90, 140], [100, 128], [130, 128]],
  [[200, 60], [200, 120], [215, 135]],
  [[150, 70], [175, 70], [175, 95]],
  [[60, 100], [60, 120], [120, 120]],
];
for (const t of tr) traces += 'M' + t.map(([x, y]) => P(x, y, tz).join(',')).join('L');
parts.push({ top: 10, svg: board + `<path class="cu ln none" d="${traces}" opacity=".7"/>` });

// transformer block with windings
let xf = box(28, 96, 10, 46, 46, 30);
let wl = '';
for (let i = 1; i < 8; i++) wl += line([28 + 46, 96 + 4, 10 + i * 3.6], [28 + 46, 96 + 42, 10 + i * 3.6]);
xf += `<path class="wind ln none" d="${wl}"/>`;
parts.push({ top: 40, svg: xf });
// toroidal inductor
parts.push({ top: 30, svg: toroid(80, 52, 10, 30, 13, 20, 30) });
// IC + pins
let ic = box(128, 98, 10, 44, 30, 6);
let pins = '';
for (let i = 0; i < 6; i++) { const x = 132 + i * 7; pins += line([x, 128, 13], [x, 133, 10.5]); }
for (let i = 0; i < 4; i++) { const y = 102 + i * 7; pins += line([172, y, 13], [177, y, 10.5]); }
ic += `<path class="ln none" d="${pins}"/>` + ring(136, 104, 16, 2.2, 'ln2');
parts.push({ top: 16, svg: ic });
// capacitors
for (const [x, y, r, h] of [[176, 36, 11, 36], [206, 40, 8, 26], [214, 100, 13, 44], [150, 44, 6, 18]] as const) {
  parts.push({ top: 10 + h, svg: cyl(x, y, 10, r, h) + ring(x, y, 10 + h - 4, r, 'ln2') });
}
// resistors (small boxes)
for (const [x, y] of [[110, 64], [110, 76]]) parts.push({ top: 15, svg: box(x, y, 10, 22, 6, 5) });

// dispensing nozzle above
const NX = 150, NY = 82, NZ = 150;
const nozzle = cyl(NX, NY, NZ + 26, 16, 54) + cyl(NX, NY, NZ + 10, 7, 16) + cyl(NX, NY, NZ, 2.5, 10);
const [sx, sy] = P(NX, NY, NZ);

// floor grid under everything
let floor = '';
for (let x = -60; x <= W + 60; x += 30) floor += line([x, -60, 0], [x, D + 60, 0]);
for (let y = -60; y <= D + 60; y += 30) floor += line([-60, y, 0], [W + 60, y, 0]);
const vb = viewBox([-60, -60, 0], [W + 70, D + 60, NZ + 84], 6);

// dimension line along front-right edge
const [d1x, d1y] = P(W + 18, 0, 0), [d2x, d2y] = P(W + 18, D, 0);
---
<svg class="iso hero-scene" viewBox={vb} role="img" aria-label="Isometric drawing of a potting housing being filled with amber resin"
  data-w={W} data-d={D} data-h={H} data-level={LEVEL} data-nx={sx} data-ny={sy} data-nz={NZ}>
  <g class="floor"><path class="ln2" d={floor} /></g>
  <g data-draw>
    <Fragment set:html={trayBack(0, 0, 0, W, D, H)} />
    {parts.map((p) => <g class="part" data-top={p.top} set:html={p.svg} />)}
  </g>
  <g id="resin-g">
    <path id="resin-side" class="resin-side" d="" />
    <path id="resin-top" class="resin-top" d="" />
    <path id="resin-sheen" class="resin-sheen" d="" />
  </g>
  <g data-draw>
    <Fragment set:html={trayFront(0, 0, 0, W, D, H)} />
    <path class="ln2 dash" d={`M${d1x},${d1y}L${d2x},${d2y}`} />
    <path class="ln2" d={`M${d1x - 4},${d1y - 6}L${d1x + 4},${d1y + 6}M${d2x - 4},${d2y - 6}L${d2x + 4},${d2y + 6}`} />
    <text class="lbl" x={(d1x + d2x) / 2 + 10} y={(d1y + d2y) / 2 + 4}>170</text>
  </g>
  <line id="stream" class="stream" x1={sx} y1={sy} x2={sx} y2={sy} />
  <g class="nozzle" data-draw set:html={nozzle} />
  <g id="gauge" class="gauge">
    {Array.from({ length: 8 }, (_, i) => {
      const [gx, gy] = P(-22, D, (i / 7) * H);
      return <path class="ln2" d={`M${gx},${gy}L${gx - (i % 7 === 0 ? 12 : 7)},${gy}`} />;
    })}
    <path class="ln2" d={`M${P(-22, D, 0).join(',')}L${P(-22, D, H).join(',')}`} />
    <g id="gauge-mark"><path class="am" stroke-width="1.5" d={`M${P(-22, D, 0)[0] - 16},${P(-22, D, 0)[1]}h16`} /><text class="lbl-a" x={P(-22, D, 0)[0] - 64} y={P(-22, D, 0)[1] + 3.5}>00%</text></g>
  </g>
</svg>
<style>
  .hero-scene { width: 100%; height: auto; }
  .hero-scene :global(.pcb) { fill: var(--pcb); }
  .hero-scene :global(.part) { transition: opacity .6s; }
  .hero-scene :global(.part.sub .ln) { stroke: rgba(244, 166, 42, .55); }
  .resin-side { fill: rgba(244, 166, 42, .20); stroke: var(--amber); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .resin-top { fill: rgba(255, 196, 92, .30); stroke: var(--amber-2); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .resin-sheen { fill: none; stroke: rgba(255, 240, 210, .8); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .stream { stroke: var(--amber); stroke-width: 3; stroke-linecap: round; opacity: 0; filter: drop-shadow(0 0 6px rgba(244,166,42,.6)); }
  .hero-scene.cured .resin-side { fill: rgba(184, 107, 14, .55); stroke: var(--amber-deep); }
  .hero-scene.cured .resin-top { fill: rgba(196, 122, 30, .62); stroke: var(--amber); }
  .hero-scene .resin-side, .hero-scene .resin-top { transition: fill 1.2s var(--ease), stroke 1.2s; }
</style>
